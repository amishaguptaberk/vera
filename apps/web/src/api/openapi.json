{
    "openapi": "3.1.0",
    "info": {
        "title": "Vera API",
        "version": "0.1.0"
    },
    "paths": {
        "/api/cases": {
            "get": {
                "summary": "List Cases",
                "operationId": "list_cases_api_cases_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "items": {
                                        "$ref": "#/components/schemas/QueueRow"
                                    },
                                    "type": "array",
                                    "title": "Response List Cases Api Cases Get"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/cases/summary": {
            "get": {
                "summary": "Summary",
                "operationId": "summary_api_cases_summary_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Summary"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/cases/{case_id}": {
            "get": {
                "summary": "Get Case",
                "operationId": "get_case_api_cases__case_id__get",
                "parameters": [
                    {
                        "name": "case_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Case Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CaseView"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/cases/{case_id}/available-actions": {
            "get": {
                "summary": "Available",
                "operationId": "available_api_cases__case_id__available_actions_get",
                "parameters": [
                    {
                        "name": "case_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Case Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ActionView"
                                    },
                                    "title": "Response Available Api Cases  Case Id  Available Actions Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/cases/{case_id}/commands/{command}": {
            "post": {
                "summary": "Run Command",
                "operationId": "run_command_api_cases__case_id__commands__command__post",
                "parameters": [
                    {
                        "name": "case_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Case Id"
                        }
                    },
                    {
                        "name": "command",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Command"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CommandIn"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CommandOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/reports": {
            "post": {
                "summary": "Post Report",
                "operationId": "post_report_api_reports_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ReportIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ReportOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/policies/{policy_id}": {
            "get": {
                "summary": "Get Policy",
                "operationId": "get_policy_api_policies__policy_id__get",
                "parameters": [
                    {
                        "name": "policy_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Policy Id"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Get Policy Api Policies  Policy Id  Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/policies/{policy_id}/versions/{version}": {
            "get": {
                "summary": "Get Policy Version",
                "operationId": "get_policy_version_api_policies__policy_id__versions__version__get",
                "parameters": [
                    {
                        "name": "policy_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "Policy Id"
                        }
                    },
                    {
                        "name": "version",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "title": "Version"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "title": "Response Get Policy Version Api Policies  Policy Id  Versions  Version  Get"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/session": {
            "get": {
                "summary": "Get Session Info",
                "operationId": "get_session_info_api_session_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionOut"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/session/role": {
            "post": {
                "summary": "Switch Role",
                "description": "Demo view change only: the server picks the user; nothing is written to cases.",
                "operationId": "switch_role_api_session_role_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RoleIn"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionOut"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/demo/reset": {
            "post": {
                "summary": "Reset",
                "operationId": "reset_api_demo_reset_post",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": {
                                        "type": "string"
                                    },
                                    "type": "object",
                                    "title": "Response Reset Api Demo Reset Post"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/demo/counts": {
            "get": {
                "summary": "Counts",
                "operationId": "counts_api_demo_counts_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "additionalProperties": {
                                        "type": "integer"
                                    },
                                    "type": "object",
                                    "title": "Response Counts Api Demo Counts Get"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ActionView": {
                "properties": {
                    "command": {
                        "type": "string",
                        "title": "Command"
                    },
                    "label": {
                        "type": "string",
                        "title": "Label"
                    },
                    "role": {
                        "$ref": "#/components/schemas/Role"
                    },
                    "style": {
                        "type": "string",
                        "enum": [
                            "primary",
                            "secondary",
                            "dark",
                            "ghost"
                        ],
                        "title": "Style"
                    },
                    "enabled": {
                        "type": "boolean",
                        "title": "Enabled"
                    },
                    "blocked_reason": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Blocked Reason"
                    },
                    "expected_state": {
                        "$ref": "#/components/schemas/CaseState"
                    },
                    "expected_step": {
                        "$ref": "#/components/schemas/CaseStep"
                    },
                    "safe_note": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Safe Note"
                    },
                    "confirm": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Confirm"
                    },
                    "idempotency_key": {
                        "type": "string",
                        "title": "Idempotency Key"
                    },
                    "payload_defaults": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Payload Defaults",
                        "default": {}
                    },
                    "key_template": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Key Template"
                    }
                },
                "type": "object",
                "required": [
                    "command",
                    "label",
                    "role",
                    "style",
                    "enabled",
                    "expected_state",
                    "expected_step",
                    "idempotency_key"
                ],
                "title": "ActionView"
            },
            "BlockedAction": {
                "properties": {
                    "command": {
                        "type": "string",
                        "title": "Command"
                    },
                    "label": {
                        "type": "string",
                        "title": "Label"
                    },
                    "reason": {
                        "type": "string",
                        "title": "Reason"
                    },
                    "blocked_reason": {
                        "type": "string",
                        "title": "Blocked Reason"
                    }
                },
                "type": "object",
                "required": [
                    "command",
                    "label",
                    "reason",
                    "blocked_reason"
                ],
                "title": "BlockedAction"
            },
            "CardholderView": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    },
                    "contact_on_file": {
                        "$ref": "#/components/schemas/ContactOnFile"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "contact_on_file"
                ],
                "title": "CardholderView"
            },
            "CaseState": {
                "type": "string",
                "enum": [
                    "reported",
                    "investigating",
                    "waiting_on_cardholder",
                    "response_received",
                    "evidence_review",
                    "callback_pending",
                    "callback_completed",
                    "decision_pending",
                    "policy_blocked",
                    "credit_eligible",
                    "reviewer_pending",
                    "credit_approved",
                    "credit_issued",
                    "dispute_prepared",
                    "remediation_pending",
                    "monitoring",
                    "closed",
                    "held"
                ],
                "title": "CaseState"
            },
            "CaseStep": {
                "type": "string",
                "enum": [
                    "intake",
                    "working",
                    "draft",
                    "waiting",
                    "noresp1",
                    "noresp2",
                    "response",
                    "idv",
                    "verify",
                    "callfail",
                    "packet",
                    "decide",
                    "returned",
                    "stale",
                    "waitrv",
                    "issue",
                    "credit_check",
                    "controls",
                    "ctl_prep",
                    "dsp_prepare",
                    "dsp_open",
                    "dsp_review",
                    "dsp_submit",
                    "dsp_failed",
                    "waitctl",
                    "ctl_apply",
                    "finalprep",
                    "final",
                    "close",
                    "monitoring",
                    "closed",
                    "onhold"
                ],
                "title": "CaseStep"
            },
            "CaseView": {
                "properties": {
                    "case_id": {
                        "type": "string",
                        "title": "Case Id"
                    },
                    "case_version": {
                        "type": "integer",
                        "title": "Case Version"
                    },
                    "state": {
                        "$ref": "#/components/schemas/CaseState"
                    },
                    "step": {
                        "$ref": "#/components/schemas/CaseStep"
                    },
                    "state_label": {
                        "type": "string",
                        "title": "State Label"
                    },
                    "state_kind": {
                        "$ref": "#/components/schemas/StateKind"
                    },
                    "next_action": {
                        "type": "string",
                        "title": "Next Action"
                    },
                    "owner": {
                        "$ref": "#/components/schemas/Person"
                    },
                    "waiting_on": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/Person"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "due": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/Due"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "pins": {
                        "$ref": "#/components/schemas/Pins"
                    },
                    "transaction": {
                        "$ref": "#/components/schemas/TransactionView"
                    },
                    "cardholder": {
                        "$ref": "#/components/schemas/CardholderView"
                    },
                    "charge_impact": {
                        "$ref": "#/components/schemas/ChargeImpact"
                    },
                    "available_actions": {
                        "items": {
                            "$ref": "#/components/schemas/ActionView"
                        },
                        "type": "array",
                        "title": "Available Actions"
                    },
                    "blocked_actions": {
                        "items": {
                            "$ref": "#/components/schemas/BlockedAction"
                        },
                        "type": "array",
                        "title": "Blocked Actions",
                        "default": []
                    },
                    "recovery_actions": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Recovery Actions",
                        "default": []
                    },
                    "hold": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/Hold"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "policy": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/PolicyView"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "case_id",
                    "case_version",
                    "state",
                    "step",
                    "state_label",
                    "state_kind",
                    "next_action",
                    "owner",
                    "waiting_on",
                    "due",
                    "pins",
                    "transaction",
                    "cardholder",
                    "charge_impact",
                    "available_actions"
                ],
                "title": "CaseView"
            },
            "ChargeImpact": {
                "properties": {
                    "posted_cents": {
                        "type": "integer",
                        "title": "Posted Cents"
                    },
                    "credit_cents": {
                        "type": "integer",
                        "title": "Credit Cents"
                    },
                    "exposure_cents": {
                        "type": "integer",
                        "title": "Exposure Cents"
                    },
                    "note": {
                        "type": "string",
                        "title": "Note"
                    }
                },
                "type": "object",
                "required": [
                    "posted_cents",
                    "credit_cents",
                    "exposure_cents",
                    "note"
                ],
                "title": "ChargeImpact"
            },
            "CommandIn": {
                "properties": {
                    "idempotency_key": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Idempotency Key"
                    },
                    "expected_case_version": {
                        "type": "integer",
                        "title": "Expected Case Version"
                    },
                    "payload": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Payload"
                    }
                },
                "type": "object",
                "required": [
                    "idempotency_key",
                    "expected_case_version"
                ],
                "title": "CommandIn"
            },
            "CommandOut": {
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "recorded",
                            "replayed"
                        ],
                        "title": "Status"
                    },
                    "result": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Result"
                    },
                    "event_ids": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Event Ids"
                    },
                    "case": {
                        "$ref": "#/components/schemas/CaseView"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "result",
                    "event_ids",
                    "case"
                ],
                "title": "CommandOut"
            },
            "ContactOnFile": {
                "properties": {
                    "phone_masked": {
                        "type": "string",
                        "title": "Phone Masked"
                    },
                    "email": {
                        "type": "string",
                        "title": "Email"
                    },
                    "verified_at": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Verified At"
                    }
                },
                "type": "object",
                "required": [
                    "phone_masked",
                    "email",
                    "verified_at"
                ],
                "title": "ContactOnFile"
            },
            "Due": {
                "properties": {
                    "at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "At"
                    },
                    "label": {
                        "type": "string",
                        "title": "Label"
                    },
                    "overdue": {
                        "type": "boolean",
                        "title": "Overdue"
                    }
                },
                "type": "object",
                "required": [
                    "at",
                    "label",
                    "overdue"
                ],
                "title": "Due"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "Hold": {
                "properties": {
                    "reason": {
                        "type": "string",
                        "title": "Reason"
                    },
                    "next_owner_id": {
                        "type": "string",
                        "title": "Next Owner Id"
                    },
                    "due_at": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date-time"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Due At"
                    },
                    "held_by": {
                        "type": "string",
                        "title": "Held By"
                    },
                    "held_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Held At"
                    }
                },
                "type": "object",
                "required": [
                    "reason",
                    "next_owner_id",
                    "held_by",
                    "held_at"
                ],
                "title": "Hold"
            },
            "Person": {
                "properties": {
                    "id": {
                        "type": "string",
                        "title": "Id"
                    },
                    "name": {
                        "type": "string",
                        "title": "Name"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "title": "Person"
            },
            "Pins": {
                "properties": {
                    "workflow_version": {
                        "type": "integer",
                        "title": "Workflow Version"
                    },
                    "policy_version": {
                        "type": "integer",
                        "title": "Policy Version"
                    },
                    "evidence_snapshot": {
                        "type": "string",
                        "title": "Evidence Snapshot"
                    }
                },
                "type": "object",
                "required": [
                    "workflow_version",
                    "policy_version",
                    "evidence_snapshot"
                ],
                "title": "Pins"
            },
            "PolicyView": {
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "eligible",
                            "needs_evidence",
                            "blocked",
                            "ineligible"
                        ],
                        "title": "Status"
                    },
                    "code": {
                        "type": "string",
                        "title": "Code"
                    },
                    "label": {
                        "type": "string",
                        "title": "Label"
                    },
                    "rules_passed": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Rules Passed"
                    },
                    "rules_failed": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Rules Failed"
                    },
                    "evidence_used": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Evidence Used"
                    },
                    "snapshot": {
                        "type": "string",
                        "title": "Snapshot"
                    },
                    "policy_version": {
                        "type": "integer",
                        "title": "Policy Version"
                    },
                    "evaluated_at": {
                        "type": "string",
                        "format": "date-time",
                        "title": "Evaluated At"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "code",
                    "label",
                    "rules_passed",
