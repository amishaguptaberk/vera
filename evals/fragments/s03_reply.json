{
  "title": "Cardholder replies with a receipt; the Response Reviewer runs (replay)",
  "synthetic": true,
  "steps": [
    {
      "as": "cardholder",
      "get": "/api/requests",
      "capture": {
        "rid": "requests.0.request_id"
      }
    },
    {
      "as": "cardholder",
      "post": "/api/requests/${rid}/responses",
      "body": {
        "text": "Attached is the Northstar receipt. I placed this order for the warehouse myself.",
        "attachment": {
          "file_name": "northstar-receipt.pdf",
          "content_type": "application/pdf",
          "size_bytes": 48213,
          "sha256": "4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f4f"
        }
      }
    },
    {
      "service": "drain_worker"
    }
  ]
}
