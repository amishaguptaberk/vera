{
  "id": "EC-41",
  "title": "The same command sent twice with the same key replays the first result; a different payload under that key is refused",
  "synthetic": true,
  "categories": [
    "reliability"
  ],
  "covers": [
    "duplicate_command"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
    "report": "I do not recognize this charge.",
    "state": "reported",
    "step": "intake"
  },
  "source_records": {
    "records": {
      "CHG-1042": {
        "merchant": "Northstar Equipment",
        "amount_cents": 284000,
        "card_last4": "4418"
      },
      "PO-219": {
        "approved_quantity": 1,
        "approved_amount_cents": 240000
      },
      "DLV-882": {
        "received_quantity": 2
      },
      "REP-1042": {
        "statement": "I do not recognize this charge."
      }
    },
    "absent_kinds": [
      "receipt"
    ]
  },
  "expected_extracted_facts": [
    {
      "kind": "discrepancy",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ]
      ],
      "statement_contains": [
        "No receipt"
      ]
    }
  ],
  "evidence_references": {
    "all_findings_cited": true
  },
  "contradictions": {
    "open": [
      "amount",
      "quantity"
    ]
  },
  "missing_evidence": [
    "receipt"
  ],
  "expected_specialist_outputs": {
    "charge_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "related_transaction_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "receipt_document_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    }
  },
  "expected_policy": {
    "status": "blocked",
    "code": "EVIDENCE_CONFLICT",
    "rules_failed_include": [
      "purchase_records_agree"
    ]
  },
  "expected_workflow_state": {
    "state": "waiting_on_cardholder",
    "step": "waiting"
  },
  "allowed_next_commands": {
    "analyst": [
      "send_reminder"
    ]
  },
  "forbidden_commands": [],
  "expected_audit_events": {
    "counts": {
      "communication.sent": 1
    }
  },
  "expected_final_outcome": {
    "state": "waiting_on_cardholder",
    "step": "waiting",
    "executions": {
      "messaging.send": {
        "succeeded": 1
      }
    }
  },
  "steps": [
    {
      "fragment": "s01_investigate"
    },
    {
      "as": "analyst",
      "command": "draft_follow_up"
    },
    {
      "service": "drain_worker"
    },
    {
      "as": "analyst",
      "get": "/api/cases/CHG-1042/communications",
      "capture": {
        "msg": "0.id"
      }
    },
    {
      "as": "analyst",
      "get": "/api/cases/CHG-1042/communications/${msg}",
      "capture": {
        "subject": "subject"
      }
    },
    {
      "as": "analyst",
      "command": "send_communication",
      "payload": {
        "channel": "email",
        "subject": "${subject}"
      },
      "capture": {
        "send_key": "$key"
      }
    },
    {
      "as": "analyst",
      "command": "send_communication",
      "payload": {
        "channel": "email",
        "subject": "${subject}"
      },
      "raw_key": "send:CHG-1042",
      "version_offset": -1,
      "times": 2,
      "expect": {
        "result_status": "replayed"
      }
    },
    {
      "as": "analyst",
      "command": "send_communication",
      "payload": {
        "channel": "portal",
        "subject": "${subject}"
      },
      "raw_key": "send:CHG-1042",
      "version_offset": -1,
      "expect": {
        "http": 409,
        "code": "idempotency_key_conflict"
      }
    },
    {
      "assert": {
        "idempotency": [
          {
            "key": "send:CHG-1042",
            "attempts": 3,
            "status": "completed"
          }
        ]
      }
    }
  ]
}
