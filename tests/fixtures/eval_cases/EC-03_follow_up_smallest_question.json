{
  "id": "EC-03",
  "title": "Follow-up asks only for what is missing (receipt, who placed the order) and waits for the cardholder",
  "synthetic": true,
  "categories": [
    "evidence",
    "product_projection"
  ],
  "covers": [
    "missing_receipt"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
    "report": "I do not recognize this charge.",
    "state": "reported",
    "step": "intake"
  },
  "source_records": {
    "records": {
      "CHG-1042": {
        "merchant": "Northstar Equipment",
        "amount_cents": 284000,
        "card_last4": "4418"
      },
      "PO-219": {
        "approved_quantity": 1,
        "approved_amount_cents": 240000
      },
      "DLV-882": {
        "received_quantity": 2
      },
      "REP-1042": {
        "statement": "I do not recognize this charge."
      }
    },
    "absent_kinds": [
      "receipt"
    ]
  },
  "expected_extracted_facts": [
    {
      "kind": "conflict",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ],
        [
          "PO-219",
          "approved_amount_cents"
        ]
      ],
      "statement_contains": [
        "$440.00"
      ],
      "status": "open"
    },
    {
      "kind": "conflict",
      "cites": [
        [
          "PO-219",
          "approved_quantity"
        ],
        [
          "DLV-882",
          "received_quantity"
        ]
      ],
      "statement_contains": [
        "1 unit",
        "2 units"
      ],
      "status": "open"
    },
    {
      "kind": "discrepancy",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ]
      ],
      "statement_contains": [
        "No receipt"
      ]
    }
  ],
  "evidence_references": {
    "all_findings_cited": true
  },
  "contradictions": {
    "open": [
      "amount",
      "quantity"
    ]
  },
  "missing_evidence": [
    "receipt"
  ],
  "expected_specialist_outputs": {
    "charge_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "related_transaction_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "receipt_document_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "cardholder_follow_up": {
      "status": "succeeded",
      "execution_mode": "replay"
    },
    "_follow_up": {
      "max_questions": 2,
      "asks_about": [
        "receipt"
      ],
      "never_asks_about": [
        "purchase order",
        "PO-219",
        "phone"
      ],
      "status": "sent"
    }
  },
  "expected_policy": {
    "status": "blocked",
    "code": "EVIDENCE_CONFLICT",
    "rules_failed_include": [
      "purchase_records_agree"
    ]
  },
  "expected_workflow_state": {
    "state": "waiting_on_cardholder",
    "step": "waiting"
  },
  "allowed_next_commands": {
    "analyst": [
      "send_reminder",
      "hold_case"
    ]
  },
  "forbidden_commands": [
    {
      "as": "analyst",
      "command": "send_communication",
      "expect_code": "invalid_step",
      "payload": {
        "channel": "email",
        "subject": "Second request"
      }
    },
    {
      "as": "cardholder",
      "command": "send_communication",
      "expect_code": "role_forbidden",
      "payload": {
        "channel": "email",
        "subject": "Hello there"
      }
    },
    {
      "as": "analyst",
      "command": "review_cardholder_response",
      "expect_code": "invalid_step",
      "payload": {
        "outcome": "complete"
      }
    }
  ],
  "expected_audit_events": {
    "subsequence": [
