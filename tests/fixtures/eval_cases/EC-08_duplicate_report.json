{
  "id": "EC-08",
  "title": "The same charge reported twice links to the existing case: one case, one claim, no second investigation",
  "synthetic": true,
  "categories": [
    "evidence",
    "reliability"
  ],
  "covers": [
    "duplicate_transaction"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
    "report": "I do not recognize this charge.",
    "state": "reported",
    "step": "intake"
  },
  "source_records": {
    "records": {
      "CHG-1042": {
        "merchant": "Northstar Equipment",
        "amount_cents": 284000,
        "card_last4": "4418"
      },
      "PO-219": {
        "approved_quantity": 1,
        "approved_amount_cents": 240000
      },
      "DLV-882": {
        "received_quantity": 2
      },
      "REP-1042": {
        "statement": "I do not recognize this charge."
      }
    },
    "absent_kinds": [
      "receipt"
    ]
  },
  "expected_extracted_facts": [
    {
      "kind": "conflict",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ],
        [
          "PO-219",
          "approved_amount_cents"
        ]
      ],
      "statement_contains": [
        "$440.00"
      ]
    },
    {
      "kind": "conflict",
      "cites": [
        [
          "PO-219",
          "approved_quantity"
        ],
        [
          "DLV-882",
          "received_quantity"
        ]
      ],
      "statement_contains": [
        "1 unit",
        "2 units"
      ]
    }
  ],
  "evidence_references": {
    "all_findings_cited": true
  },
  "contradictions": {
    "open": [
      "amount",
      "quantity"
    ]
  },
  "missing_evidence": [
    "receipt"
  ],
  "expected_specialist_outputs": {
    "charge_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "related_transaction_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "receipt_document_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    }
  },
  "expected_policy": {
    "status": "blocked",
    "code": "EVIDENCE_CONFLICT",
    "rules_failed_include": [
      "purchase_records_agree"
    ]
  },
  "expected_workflow_state": {
    "state": "investigating",
    "step": "draft"
  },
  "allowed_next_commands": {
    "analyst": [
      "draft_follow_up"
    ]
  },
  "forbidden_commands": [
    {
      "as": "analyst",
      "command": "start_investigation",
      "expect_code": "invalid_step"
    }
  ],
  "expected_audit_events": {
    "counts": {
      "report.linked": 1,
      "investigation.started": 1,
      "case.opened": 1
    },
    "absent": [
      "case.created"
    ]
  },
  "expected_final_outcome": {
    "state": "investigating",
    "step": "draft"
  },
  "steps": [
    {
      "fragment": "s01_investigate"
    },
    {
      "as": "cardholder",
      "command": "link_report",
      "payload": {
        "statement": "Reporting this charge again: I still do not recognize it."
      }
    },
    {
      "assert": {
        "sql": [
          {
            "name": "one live case for TXN-1042",
            "query": "select count(*) from cases where transaction_id='TXN-1042'",
            "equals": [
              [
                1
              ]
            ]
          },
          {
            "name": "two reports on the case",
            "query": "select count(*) from reports where case_id='CHG-1042'",
            "equals": [
              [
                2
              ]
            ]
          }
        ]
      }
    }
  ]
}
