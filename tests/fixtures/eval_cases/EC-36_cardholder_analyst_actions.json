{
  "id": "EC-36",
  "title": "Cardholder tries analyst actions and staff reads: refused, and the cardholder sees no internal data",
  "synthetic": true,
  "categories": [
    "financial_safety",
    "product_projection"
  ],
  "covers": [
    "cardholder_analyst_action"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
    "report": "I do not recognize this charge.",
    "state": "reported",
    "step": "intake"
  },
  "source_records": {
    "records": {
      "CHG-1042": {
        "merchant": "Northstar Equipment",
        "amount_cents": 284000,
        "card_last4": "4418"
      },
      "PO-219": {
        "approved_quantity": 1,
        "approved_amount_cents": 240000
      },
      "DLV-882": {
        "received_quantity": 2
      },
      "REP-1042": {
        "statement": "I do not recognize this charge."
      }
    },
    "absent_kinds": [
      "receipt"
    ]
  },
  "expected_extracted_facts": [
    {
      "kind": "discrepancy",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ]
      ],
      "statement_contains": [
        "No receipt"
      ]
    }
  ],
  "evidence_references": {
    "all_findings_cited": true
  },
  "contradictions": {
    "open": [
      "amount",
      "quantity"
    ]
  },
  "missing_evidence": [
    "receipt"
  ],
  "expected_specialist_outputs": {
    "charge_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "related_transaction_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "receipt_document_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    }
  },
  "expected_policy": {
    "status": "blocked",
    "code": "EVIDENCE_CONFLICT",
    "rules_failed_include": [
      "purchase_records_agree"
    ]
  },
  "expected_workflow_state": {
    "state": "waiting_on_cardholder",
    "step": "waiting"
  },
  "allowed_next_commands": {
    "analyst": [
      "send_reminder"
    ]
  },
  "forbidden_commands": [
    {
      "as": "cardholder",
      "command": "send_reminder",
      "expect_code": "role_forbidden"
    },
    {
      "as": "cardholder",
      "command": "hold_case",
      "expect_code": "role_forbidden",
      "payload": {
        "reason": "hold it now",
        "next_owner": "usr-sam-rivera"
      }
    },
    {
      "as": "cardholder",
      "command": "evaluate_policy",
      "expect_code": "role_forbidden"
    },
    {
      "as": "cardholder",
      "command": "issue_provisional_credit",
      "expect_code": "role_forbidden"
    },
    {
      "as": "cardholder",
      "command": "record_decision",
      "expect_code": "role_forbidden",
      "payload": {
        "decision": "credit",
        "rationale": "Refund me."
      }
    },
    {
      "as": "cardholder",
      "command": "close_case",
      "expect_code": "role_forbidden",
      "payload": {
        "outcome": "resolved",
        "reason": "Done"
      }
    }
  ],
  "expected_audit_events": {
    "absent": [
      "credit.requested",
      "credit.issued",
      "credit.confirmed",
      "approval.approved",
      "dispute.submitted",
      "controls.applied"
    ]
  },
  "expected_final_outcome": {
    "state": "waiting_on_cardholder",
    "step": "waiting"
  },
  "steps": [
    {
      "fragment": "s01_investigate"
    },
    {
      "fragment": "s02_follow_up"
    },
    {
      "get": "/api/cases/CHG-1042/evidence",
      "as": "cardholder",
      "expect": {
        "http": 403
      }
    },
    {
      "get": "/api/cases/CHG-1042/activity",
      "as": "cardholder",
      "expect": {
        "http": 403
      }
    },
    {
      "get": "/api/requests",
      "as": "cardholder",
      "json_excludes": {
        ".": [
          "PO-219",
          "DLV-882",
          "conflict",
          "policy"
        ]
      }
    }
  ]
}
