{
  "id": "EC-25",
  "title": "Evidence changes after the reviewer approved: the approval goes stale, credit is refused, and a fresh packet and approval issue credit exactly once",
  "synthetic": true,
  "categories": [
    "financial_safety",
    "workflow",
    "reliability"
  ],
  "covers": [
    "stale_reviewer_approval",
    "reviewer_approves_credit"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
    "report": "I do not recognize this charge.",
    "state": "reported",
    "step": "intake"
  },
  "source_records": {
    "records": {
      "CHG-1042": {
        "merchant": "Northstar Equipment",
        "amount_cents": 284000,
        "card_last4": "4418"
      },
      "PO-219": {
        "approved_quantity": 1,
        "approved_amount_cents": 240000
      },
      "DLV-882": {
        "received_quantity": 2
      },
      "REP-1042": {
        "statement": "I do not recognize this charge."
      }
    },
    "absent_kinds": [
      "receipt"
    ]
  },
  "expected_extracted_facts": [
    {
      "kind": "conflict",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ],
        [
          "PO-219",
          "approved_amount_cents"
        ]
      ],
      "statement_contains": [
        "$440.00"
      ],
      "status": "resolved"
    }
  ],
  "evidence_references": {
    "all_findings_cited": true,
    "current_versions": {
      "DLV-882": 2
    }
  },
  "contradictions": {
    "open": []
  },
  "missing_evidence": [],
  "expected_specialist_outputs": {
    "charge_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "related_transaction_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "receipt_document_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "decision_packet_preparer": {
      "status": "succeeded"
    },
    "_packet": {
      "status": "ready",
      "all_statements_cited": true
    }
