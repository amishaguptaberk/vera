  "expected_policy": {
    "status": "eligible",
    "code": "CREDIT_ELIGIBLE"
  },
  "expected_workflow_state": {
    "state": "dispute_prepared",
    "step": "dsp_prepare"
  },
  "allowed_next_commands": {
