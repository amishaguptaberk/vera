{
  "id": "EC-09",
  "title": "A reply with a receipt changes the evidence snapshot; policy is re-evaluated on the new snapshot and the old result is no longer current",
  "synthetic": true,
  "categories": [
    "evidence",
    "financial_safety"
  ],
  "covers": [
    "stale_evidence_new_reply"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
    "report": "I do not recognize this charge.",
    "state": "reported",
    "step": "intake"
  },
  "source_records": {
    "records": {
      "CHG-1042": {
        "merchant": "Northstar Equipment",
        "amount_cents": 284000,
        "card_last4": "4418"
      },
      "PO-219": {
        "approved_quantity": 1,
        "approved_amount_cents": 240000
      },
      "DLV-882": {
        "received_quantity": 2
      },
      "REP-1042": {
        "statement": "I do not recognize this charge."
      }
    },
    "absent_kinds": [
      "receipt"
    ]
  },
  "expected_extracted_facts": [
    {
      "kind": "conflict",
      "cites": [
        [
          "REP-1042",
          "statement"
        ]
      ]
    },
    {
      "kind": "discrepancy",
      "cites": [
        [
          "CHG-1042",
          "amount_cents"
        ]
      ],
      "statement_contains": [
        "No receipt"
      ]
    }
  ],
  "evidence_references": {
    "all_findings_cited": true,
    "record_status": {
      "RCP-*": "supporting",
      "REP-1042": "conflicting"
    }
  },
  "contradictions": {
    "open": [
      "amount",
      "cardholder_statement",
      "quantity"
    ]
  },
  "missing_evidence": [],
  "expected_specialist_outputs": {
    "charge_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "related_transaction_investigator": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "receipt_document_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay",
      "findings": 2
    },
    "response_reviewer": {
      "status": "succeeded",
      "execution_mode": "replay"
    },
    "_response_review": "conflicting"
  },
  "expected_policy": {
    "status": "blocked",
    "rules_passed_include": [
      "receipt_required_above_threshold"
    ],
    "rules_failed_include": [
      "purchase_records_agree"
    ]
  },
  "expected_workflow_state": {
    "state": "callback_pending",
    "step": "idv"
  },
  "allowed_next_commands": {
    "analyst": [
      "send_verification_request"
    ]
  },
  "forbidden_commands": [
    {
      "as": "analyst",
      "command": "create_decision_packet",
      "expect_code": "invalid_step"
    }
  ],
  "expected_audit_events": {
    "subsequence": [
      "policy.evaluated",
      "communication.responded",
      "communication.reviewed",
      "evidence.status_changed",
      "policy.evaluated"
    ],
    "absent": [
      "credit.requested",
      "credit.issued",
      "credit.confirmed",
      "approval.approved",
      "dispute.submitted",
      "controls.applied"
    ]
  },
  "expected_final_outcome": {
    "state": "callback_pending",
    "step": "idv"
  },
  "steps": [
    {
      "fragment": "s01_investigate"
    },
    {
      "as": "analyst",
      "command": "evaluate_policy"
    },
    {
      "get": "/api/cases/CHG-1042/evidence",
      "as": "analyst",
      "capture": {
        "snap_before": "snapshot_hash"
      }
    },
    {
      "fragment": "s02_follow_up"
    },
    {
      "fragment": "s03_reply"
    },
    {
      "fragment": "s04_review_reply"
    },
    {
      "assert": {
        "sql": [
          {
            "name": "latest evaluation is on the current snapshot",
            "query": "select replace(p.snapshot_hash,'sha256:','') = replace(c.evidence_snapshot,'sha256:','') from policy_evaluations p join cases c on c.id=p.case_id where c.id='CHG-1042' order by p.id desc limit 1",
            "equals": [
              [
                true
              ]
            ]
          },
          {
            "name": "more than one snapshot was evaluated",
            "query": "select count(distinct snapshot_hash) > 1 from policy_evaluations where case_id='CHG-1042'",
            "equals": [
              [
                true
              ]
            ]
          }
        ]
      }
    },
    {
      "get": "/api/cases/CHG-1042/evidence",
      "as": "analyst",
      "json_excludes": {
        "snapshot_hash": [
          "${snap_before}"
        ]
      }
    }
  ]
}
