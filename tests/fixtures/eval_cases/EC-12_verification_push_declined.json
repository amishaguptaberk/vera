        "questions": [
          {
            "id": "q1",
            "text": "Did you place the order with Northstar Equipment?"
          }
        ]
      }
    },
    {
      "as": "analyst",
      "command": "create_decision_packet",
      "expect_code": "invalid_step"
    }
