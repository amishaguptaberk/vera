      "payload": {
        "approve": false
      },
      "capture": {
        "push_key": "$key"
      }
    },
    {
      "as": "cardholder",
      "command": "answer_verification_push",
      "route": "/api/verifications/${vid}/answer",
      "payload": {
        "approve": false,
        "verification_id": "${vid}"
      },
      "raw_key": "${push_key}",
      "version_offset": -1,
      "expect": {
        "result_status": "replayed"
