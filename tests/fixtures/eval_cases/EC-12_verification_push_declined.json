  "categories": [
    "workflow",
    "financial_safety"
  ],
  "covers": [
    "verification_declined"
  ],
  "initial_facts": {
    "case_id": "CHG-1042",
    "merchant": "Northstar Equipment",
    "amount_cents": 284000,
    "currency": "USD",
    "card_last4": "4418",
    "cardholder": "Priya Shah",
