# Copy to .env for local use. Never commit real secrets.
VERA_DATABASE_URL=postgresql+psycopg://vera:vera@127.0.0.1:54329/vera
VERA_ENV=synthetic
VERA_DEMO_TZ=America/Los_Angeles
# Required when VERA_ENV is not synthetic; a dev default is used only for synthetic.
VERA_SESSION_SECRET=
# Specialist model provider (VER-003). Names only; put the real key in .env, never commit it.
NVIDIA_API_KEY=
VERA_MODEL_PROVIDER=nvidia
VERA_BASE_URL=https://integrate.api.nvidia.com/v1
VERA_MODEL_ID=meta/llama-3.3-70b-instruct
# live | replay. Tests and CI use replay; the product default is live when a key is present.
VERA_EXECUTION_MODE=replay

# Voice verification (ElevenLabs Conversational AI over Twilio/SIP). Names only.
VERA_VOICE_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TELEPHONY=
VERA_PUBLIC_BASE_URL=
